# ====================
# SERVER CONFIGURATION
# ====================
PORT=3000
NODE_ENV=development

# ====================
# DATABASE
# ====================
# MongoDB Atlas connection string
# Format: mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/ctpat-inspections?retryWrites=true&w=majority

# ====================
# SUPABASE (File Storage)
# ====================
# Get these from Supabase Dashboard > Settings > API.
# The bucket MUST be private: PDFs are served only through the authenticated API.
# The service role key bypasses Row Level Security - keep it server-side only and
# never put it in the mobile app. Without these set (development only), PDFs are
# saved to ./.local-storage instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=ctpat-pdfs

# ====================
# CORS & SECURITY
# ====================
# Comma-separated list of allowed origins
# For development: http://localhost:8081,http://127.0.0.1:8081
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Set to true in production with HTTPS
HTTPS_ENABLED=false

# Number of reverse proxies in front of the server (Render = 1, the default in
# production). Needed so rate limiting sees real client IPs.
# TRUST_PROXY_HOPS=1

# ====================
# EMAIL SERVICE (Optional)
# ====================
# Optional: comma-separated recipient domains the app may email (empty = any)
# EMAIL_ALLOWED_DOMAINS=yourcompany.com

# Provider: smtp, sendgrid, gmail
EMAIL_PROVIDER=smtp

# SMTP Configuration (for smtp provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=huzeir2k@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ctpat-inspections.app

# SendGrid API Key (for sendgrid provider)
# SENDGRID_API_KEY=sg_xxxxxxxxxx

# ====================
# API CONFIGURATION
# ====================
# Base URL for API
API_BASE_URL=http://localhost:3000

# ====================
# RATE LIMITING
# ====================
# Requests per 15-minute window
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=20

# ====================
# LOGGING & MONITORING
# ====================
# Sentry error tracking (optional)
# SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ====================
# JWT/AUTH
# ====================
# Access tokens are verified with your project's public signing keys, downloaded
# from SUPABASE_URL (see above) - nothing else to configure for current Supabase
# projects. Check: open <SUPABASE_URL>/auth/v1/.well-known/jwks.json in a browser;
# it should list at least one key.
#
# Only for older projects that still sign tokens with a shared secret (HS256):
# Supabase Dashboard > Settings > API > JWT Settings > Legacy JWT secret.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
