@@ -0,0 +1,63 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const { listForms, getForm, toPublicForm } = require('../src/forms');
+const { buildExport, OUTPUT_FILE } = require('../scripts/export-forms');
+
+test('the five CTPAT forms are registered with the expected checklist sizes', () => {
+  const sizes = Object.fromEntries(listForms().map((f) => [f.id, f.checklist.length]));
+  assert.deepEqual(sizes, {
+    'truck-trailer-17-18': 18,
+    'container-7-8': 8,
+    'straight-truck-7-8': 8,
+    'cargo-van-7-8': 8,
+    'flatbed-6': 6,
+  });
+});
+
+test('every form has a template file, a unique id and a primary identifier field', () => {
+  const ids = new Set();
+  for (const form of listForms()) {
+    assert.ok(!ids.has(form.id), `duplicate form id ${form.id}`);
+    ids.add(form.id);
+    assert.ok(fs.existsSync(path.join(__dirname, '../assets/forms', form.template)), `${form.template} missing`);
+    assert.ok(form.fields.some((f) => f.key === form.primaryIdKey && f.type === 'text'), `${form.id} primaryIdKey`);
+  }
+});
+
+test('forms share the same sign-off fields', () => {
+  for (const form of listForms()) {
+    const keys = form.fields.map((f) => f.key);
+    for (const shared of ['securityPassed', 'agriculturalPassed', 'date', 'time', 'printName', 'inspectorSignature']) {
+      assert.ok(keys.includes(shared), `${form.id} is missing ${shared}`);
+    }
+  }
+});
+
+test('the flatbed form has no seal or VVTT; the others do', () => {
+  const keysOf = (id) => getForm(id).fields.map((f) => f.key);
+  assert.ok(!keysOf('flatbed-6').includes('sealNumber'));
+  assert.ok(!keysOf('flatbed-6').includes('vvtt'));
+  for (const id of ['container-7-8', 'straight-truck-7-8', 'cargo-van-7-8', 'truck-trailer-17-18']) {
+    assert.ok(keysOf(id).includes('sealNumber') && keysOf(id).includes('vvtt'), id);
+  }
+});
+
+test('only container and truck/trailer forms have Cross-Dock', () => {
+  const withCrossDock = listForms().filter((f) => f.fields.some((x) => x.key === 'crossDock')).map((f) => f.id);
+  assert.deepEqual(withCrossDock.sort(), ['container-7-8', 'truck-trailer-17-18']);
+});
+
+test('public form data never includes PDF layout', () => {
+  for (const form of listForms()) {
+    const publicForm = toPublicForm(form);
+    assert.equal(publicForm.layout, undefined);
+    assert.equal(publicForm.template, undefined);
+  }
+});
+
+test('the app bundle forms.generated.json is up to date (run: npm run forms:export)', (t) => {
+  if (!fs.existsSync(path.dirname(OUTPUT_FILE))) return t.skip('frontend folder not present');
+  assert.equal(fs.readFileSync(OUTPUT_FILE, 'utf8'), buildExport());
+});
diff --git a/ctpat-backend/test/helpers/fakes.js b/ctpat-backend/test/helpers/fakes.js
new file mode 100644
index 0000000..88171e0
--- /dev/null
+++ b/ctpat-backend/test/helpers/fakes.js
@@ -0,0 +1,95 @@
+/**
+ * In-memory stand-ins for MongoDB and file storage, so the workflow and API
+ * can be tested without external services.
+ */
+
+const clone = (value) => structuredClone(value);
+
+const matches = (doc, filter) =>
+  Object.entries(filter).every(([key, expected]) => {
+    if (expected && typeof expected === 'object' && '$gte' in expected) return doc[key] >= expected.$gte;
+    return doc[key] === expected;
+  });
+
+/** Chainable query that mimics the few Mongoose methods the service uses. */
+class FakeQuery {
+  constructor(docs, hideSignatures) {
+    this.docs = docs;
+    this.hideSignatures = hideSignatures;
+  }
+  select() { return this; }
+  sort() { this.docs = [...this.docs].sort((a, b) => b.createdAt - a.createdAt); return this; }
+  skip(n) { this.docs = this.docs.slice(n); return this; }
+  limit(n) { this.docs = this.docs.slice(0, n); return this; }
+  lean() {
+    const strip = ({ signatures, ...rest }) => rest;
+    const result = this.docs.map((d) => (this.hideSignatures ? strip(clone(d)) : clone(d)));
+    return Promise.resolve(this.single ? result[0] ?? null : result);
+  }
+}
+
+const createFakeInspectionModel = () => {
+  const store = [];
+  let clock = Date.now();
+
+  return {
+    store,
+
+    async create(data) {
+      if (data.idempotencyKey && store.some((d) => d.createdBy === data.createdBy && d.idempotencyKey === data.idempotencyKey)) {
+        throw Object.assign(new Error('duplicate key'), { code: 11000 });
+      }
+      clock += 1000;
+      const doc = { ...clone(data), createdAt: new Date(clock), updatedAt: new Date(clock) };
+      store.push(doc);
+      return { toObject: () => clone(doc) };
+    },
+
+    findOne(filter) {
+      const query = new FakeQuery(store.filter((d) => matches(d, filter)), true);
+      query.single = true;
+      return query;
+    },
+
+    find(filter) {
+      return new FakeQuery(store.filter((d) => matches(d, filter)), true);
+    },
+
+    async countDocuments(filter = {}) {
+      return store.filter((d) => matches(d, filter)).length;
+    },
+
+    async deleteOne(filter) {
+      const index = store.findIndex((d) => matches(d, filter));
+      if (index >= 0) store.splice(index, 1);
+    },
+
+    async updateOne(filter, update) {
+      const doc = store.find((d) => matches(d, filter));
+      if (doc && update.$push) {
+        for (const [key, value] of Object.entries(update.$push)) doc[key].push({ ...value, at: new Date() });
+      }
+    },
+  };
+};
+
+const createFakeStorage = () => {
+  const files = new Map();
+  return {
+    files,
+    failNextSave: false,
+    async save(path, buffer) {
+      if (this.failNextSave) throw new Error('storage down');
+      files.set(path, buffer);
+    },
+    async read(path) {
+      if (!files.has(path)) throw new Error('missing');
+      return files.get(path);
+    },
+    async remove(path) {
+      files.delete(path);
+    },
+  };
+};
+
+module.exports = { createFakeInspectionModel, createFakeStorage };
diff --git a/ctpat-backend/test/inspectionService.test.js b/ctpat-backend/test/inspectionService.test.js
new file mode 100644
index 0000000..56c03ec
--- /dev/null
+++ b/ctpat-backend/test/inspectionService.test.js
@@ -0,0 +1,174 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { getForm } = require('../src/forms');
+const PdfFillerService = require('../src/services/PdfFillerService');
+const { createInspectionService } = require('../src/services/InspectionService');
+const { sampleSubmission } = require('../scripts/sampleData');
+const { createFakeInspectionModel, createFakeStorage } = require('./helpers/fakes');
+
+const ALICE = 'aaaaaaaa-0000-4000-8000-000000000001';
+const BOB = 'bbbbbbbb-0000-4000-8000-000000000002';
+
+const setup = (overrides = {}) => {
+  const Inspection = createFakeInspectionModel();
+  const storage = createFakeStorage();
+  const sent = [];
+  const emailer = { sendInspectionReport: async (args) => { sent.push(args); return { messageId: 'm1', recipient: args.to }; } };
+  const service = createInspectionService({
+    Inspection,
+    storage,
+    pdfFiller: PdfFillerService,
+    emailer,
+    getForm,
+    logger: { error() {} },
+    ...overrides,
+  });
+  return { service, Inspection, storage, sent };
+};
+
+const body = (formId = 'container-7-8') => sampleSubmission(getForm(formId));
+
+test('create renders a PDF, stores it privately and saves the record', async () => {
+  const { service, Inspection, storage } = setup();
+  const { inspection, isDuplicate } = await service.create(ALICE, body());
+
+  assert.equal(isDuplicate, false);
+  assert.equal(inspection.createdBy, ALICE);
+  assert.equal(inspection.formId, 'container-7-8');
+  assert.equal(inspection.summaryId, 'MSKU1234567');
+  assert.equal(inspection.checklist.length, 8);
+  assert.equal(inspection.values.printName, 'Nandu Peña');
+  assert.equal(inspection.values.inspectorSignature, undefined, 'signatures are not stored with the answers');
+  assert.ok(inspection.signatures.inspectorSignature);
+
+  assert.ok(inspection.pdfStoragePath.startsWith(`inspections/${ALICE}/`));
+  assert.equal(storage.files.get(inspection.pdfStoragePath).subarray(0, 5).toString(), '%PDF-');
+  assert.equal(Inspection.store.length, 1);
+});
+
+test('forms without a vehicle number are identified by their seal number', async () => {
+  const { service } = setup();
+  const { inspection } = await service.create(ALICE, body('cargo-van-7-8'));
+  assert.equal(inspection.summaryId, 'SL-7788123');
+});
+
+test('invalid submissions are rejected before anything is stored', async () => {
+  const { service, storage, Inspection } = setup();
+  const bad = body();
+  bad.values.sealNumber = '';
+  await assert.rejects(service.create(ALICE, bad), { statusCode: 400 });
+  await assert.rejects(service.create(ALICE, { ...body(), formId: 'nope' }), { statusCode: 400 });
+  await assert.rejects(service.create(ALICE, undefined), { statusCode: 400 });
+  assert.equal(storage.files.size, 0);
+  assert.equal(Inspection.store.length, 0);
+});
+
+test('the same idempotency key returns the original record', async () => {
+  const { service, Inspection } = setup();
+  const first = await service.create(ALICE, body(), 'key-12345678');
+  const second = await service.create(ALICE, body(), 'key-12345678');
+
+  assert.equal(second.isDuplicate, true);
+  assert.equal(second.inspection.inspectionId, first.inspection.inspectionId);
+  assert.equal(Inspection.store.length, 1);
+});
+
+test('idempotency keys are private to each user', async () => {
+  const { service, Inspection } = setup();
+  await service.create(ALICE, body(), 'shared-key-1');
+  const bobs = await service.create(BOB, body(), 'shared-key-1');
+  assert.equal(bobs.isDuplicate, false);
+  assert.equal(Inspection.store.length, 2);
+});
+
+test('a failed database save removes the stored PDF', async () => {
+  const { service, storage, Inspection } = setup();
+  Inspection.create = async () => { throw new Error('db down'); };
+  await assert.rejects(service.create(ALICE, body()), /db down/);
+  assert.equal(storage.files.size, 0);
+});
+
+test('a storage failure stops the save', async () => {
+  const { service, storage, Inspection } = setup();
+  storage.failNextSave = true;
+  await assert.rejects(service.create(ALICE, body()), /storage down/);
+  assert.equal(Inspection.store.length, 0);
+});
+
+test('users only ever see their own inspections', async () => {
+  const { service } = setup();
+  const alices = (await service.create(ALICE, body())).inspection;
+  await service.create(BOB, body('flatbed-6'));
+
+  const list = await service.list(ALICE, { page: 1, limit: 20 });
+  assert.equal(list.pagination.total, 1);
+  assert.equal(list.inspections[0].inspectionId, alices.inspectionId);
+  assert.equal(list.inspections[0].signatures, undefined);
+
+  await assert.rejects(service.get(BOB, alices.inspectionId), { statusCode: 404 });
+  await assert.rejects(service.getPdf(BOB, alices.inspectionId), { statusCode: 404 });
+  await assert.rejects(service.remove(BOB, alices.inspectionId), { statusCode: 404 });
+  await assert.rejects(service.sendEmail(BOB, alices.inspectionId, 'a@b.com'), { statusCode: 404 });
+  assert.equal((await service.stats(BOB)).total, 1);
+  assert.equal((await service.stats(ALICE)).total, 1);
+
+  assert.ok(await service.get(ALICE, alices.inspectionId));
+});
+
+test('list can be filtered by form and paginated', async () => {
+  const { service } = setup();
+  await service.create(ALICE, body('container-7-8'));
+  await service.create(ALICE, body('flatbed-6'));
+  await service.create(ALICE, body('flatbed-6'));
+
+  assert.equal((await service.list(ALICE, { page: 1, limit: 20, formId: 'flatbed-6' })).pagination.total, 2);
+  const page2 = await service.list(ALICE, { page: 2, limit: 2 });
+  assert.equal(page2.inspections.length, 1);
+  assert.equal(page2.pagination.pages, 2);
+});
+
+test('remove deletes the record and its PDF', async () => {
+  const { service, storage, Inspection } = setup();
+  const { inspection } = await service.create(ALICE, body());
+  await service.remove(ALICE, inspection.inspectionId);
+  assert.equal(Inspection.store.length, 0);
+  assert.equal(storage.files.size, 0);
+});
+
+test('email sends the stored PDF to the recipient and is audited', async () => {
+  const { service, sent, Inspection } = setup();
+  const { inspection } = await service.create(ALICE, body());
+  await service.sendEmail(ALICE, inspection.inspectionId, 'dispatch@example.com');
+
+  assert.equal(sent.length, 1);
+  assert.equal(sent[0].to, 'dispatch@example.com');
+  assert.equal(sent[0].pdf.subarray(0, 5).toString(), '%PDF-');
+  assert.equal(Inspection.store[0].auditLog.at(-1).action, 'emailed');
+});
+
+test('email honours the allowed-domain list', async () => {
+  const { service, sent } = setup({ allowedEmailDomains: ['company.com'] });
+  const { inspection } = await service.create(ALICE, body());
+
+  await assert.rejects(service.sendEmail(ALICE, inspection.inspectionId, 'x@evil.com'), { statusCode: 403 });
+  await service.sendEmail(ALICE, inspection.inspectionId, 'x@company.com');
+  assert.equal(sent.length, 1);
+});
+
+test('an email failure is reported without internal details', async () => {
+  const emailer = { sendInspectionReport: async () => { throw new Error('smtp password wrong for host x'); } };
+  const { service } = setup({ emailer });
+  const { inspection } = await service.create(ALICE, body());
+  await assert.rejects(service.sendEmail(ALICE, inspection.inspectionId, 'a@b.com'), (error) => {
+    assert.equal(error.statusCode, 502);
+    assert.ok(!/password|host/.test(error.message));
+    return true;
+  });
+});
+
+test('preview accepts partial data and stores nothing', async () => {
+  const { service, storage, Inspection } = setup();
+  const pdf = await service.preview({ formId: 'flatbed-6', templateVersion: getForm('flatbed-6').version, checklist: { 'deck-floor': true }, values: {} });
+  assert.equal(pdf.subarray(0, 5).toString(), '%PDF-');
+  assert.equal(storage.files.size + Inspection.store.length, 0);
+});
diff --git a/ctpat-backend/test/pdf.test.js b/ctpat-backend/test/pdf.test.js
new file mode 100644
index 0000000..676c9a2
--- /dev/null
+++ b/ctpat-backend/test/pdf.test.js
@@ -0,0 +1,89 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { PDFDocument } = require('pdf-lib');
+const { listForms } = require('../src/forms');
+const { validateSubmission } = require('../src/validators/submissionValidator');
+const PdfFillerService = require('../src/services/PdfFillerService');
+const { sampleSubmission } = require('../scripts/sampleData');
+
+const render = (form, options) => PdfFillerService.generate(form, validateSubmission(form, sampleSubmission(form, options)));
+
+// Checks the structure strict readers (such as Foxit) care about.
+const assertStrictPdfStructure = (buffer) => {
+  const text = buffer.toString('latin1');
+  assert.match(text, /^%PDF-1\.\d/);
+  assert.match(text.trimEnd(), /%%EOF$/);
+  assert.ok(!text.includes('/ObjStm'), 'object streams are avoided');
+  assert.ok(!/\/Type\s*\/XRef/.test(text), 'a classic xref table is used');
+
+  const startxref = Number(/startxref\s+(\d+)\s+%%EOF\s*$/.exec(text)[1]);
+  assert.equal(text.slice(startxref, startxref + 4), 'xref', 'startxref points at the xref table');
+};
+
+test('every form renders to a valid single-page PDF', async () => {
+  for (const form of listForms()) {
+    for (const optionIndex of [0, 1]) {
+      const pdf = await render(form, { optionIndex });
+      assertStrictPdfStructure(pdf);
+
+      const reloaded = await PDFDocument.load(pdf, { throwOnInvalidObject: true });
+      assert.equal(reloaded.getPageCount(), 1, form.id);
+      assert.deepEqual(
+        [reloaded.getPage(0).getWidth(), reloaded.getPage(0).getHeight()],
+        [612, 792],
+        `${form.id} keeps the template page size`
+      );
+    }
+  }
+});
+
+test('filling a form adds content to the template', async () => {
+  const form = listForms()[0];
+  const filled = await render(form);
+  const blank = require('fs').readFileSync(require('path').join(__dirname, '../assets/forms', form.template));
+  assert.ok(filled.length > blank.length * 0.9);
+  assert.notDeepEqual(filled, blank);
+});
+
+test('long text is shrunk to fit instead of failing', async () => {
+  const form = listForms().find((f) => f.id === 'container-7-8');
+  const submission = sampleSubmission(form);
+  submission.values.containerNumber = 'W'.repeat(20);
+  await assert.doesNotReject(PdfFillerService.generate(form, validateSubmission(form, submission)));
+});
+
+const TINY_JPEG = '';
+
+test('JPEG and typed signatures are drawn; unreadable images give a clear 400', async () => {
+  const form = listForms().find((f) => f.id === 'flatbed-6');
+  const withSignature = (signature) => {
+    const submission = sampleSubmission(form);
+    submission.values.inspectorSignature = signature;
+    return PdfFillerService.generate(form, validateSubmission(form, submission));
+  };
+
+  assertStrictPdfStructure(await withSignature({ type: 'image', data: TINY_JPEG }));
+  assertStrictPdfStructure(await withSignature({ type: 'typed', text: 'Nandu Peña' }));
+
+  // Has PNG magic bytes but is not a decodable PNG.
+  const brokenPng = Buffer.concat([Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]), Buffer.from('garbage-garbage')]);
+  await assert.rejects(withSignature({ type: 'image', data: brokenPng.toString('base64') }), { statusCode: 400 });
+});
+
+test('the freight bill number is printed on every form', async () => {
+  const { execFileSync } = require('node:child_process');
+  const fs = require('node:fs');
+  const os = require('node:os');
+  const path = require('node:path');
+
+  for (const form of listForms()) {
+    const file = path.join(os.tmpdir(), `freight-${form.id}-${process.pid}.pdf`);
+    fs.writeFileSync(file, await render(form));
+    try {
+      const printed = execFileSync('pdftotext', ['-layout', file, '-'], { encoding: 'utf8' });
+      assert.match(printed, /Freight Bill #:\s*FB-0012345/, form.id);
+    } finally {
+      fs.rmSync(file, { force: true });
+    }
+  }
+});
diff --git a/ctpat-backend/test/validation.test.js b/ctpat-backend/test/validation.test.js
