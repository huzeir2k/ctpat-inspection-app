index 0000000..e8bcd43
--- /dev/null
+++ b/ctpat-backend/src/forms/index.js
@@ -0,0 +1,33 @@
+/**
+ * Form registry: the single place that knows which inspection forms exist.
+ * To add a form, create a definition file and list it below.
+ */
+
+const flatbed6 = require('./definitions/flatbed6');
+const cargoVan78 = require('./definitions/cargoVan78');
+const container78 = require('./definitions/container78');
+const straightTruck78 = require('./definitions/straightTruck78');
+const truckTrailer1718 = require('./definitions/truckTrailer1718');
+
+const FORMS = Object.freeze([truckTrailer1718, container78, straightTruck78, cargoVan78, flatbed6]);
+
+const formsById = new Map(FORMS.map((form) => [form.id, form]));
+
+const getForm = (formId) => formsById.get(formId) || null;
+
+const listForms = () => FORMS;
+
+/**
+ * The part of a definition the mobile app needs: everything except where
+ * things are printed on the PDF.
+ */
+const toPublicForm = ({ id, label, title, version, checklist, fields }) => ({
+  id,
+  label,
+  title,
+  version,
+  checklist,
+  fields,
+});
+
+module.exports = { getForm, listForms, toPublicForm };
diff --git a/ctpat-backend/src/forms/layout.js b/ctpat-backend/src/forms/layout.js
new file mode 100644
index 0000000..381acc8
--- /dev/null
+++ b/ctpat-backend/src/forms/layout.js
@@ -0,0 +1,65 @@
+/**
+ * Helpers that describe WHERE a value is printed on a form template.
+ *
+ * Coordinates are in PDF points, measured from the TOP-LEFT corner of the
+ * page (the same system `pdftotext -bbox` reports), which makes them easy to
+ * read off a template. The renderer converts them to PDF's bottom-left origin.
+ */
+
+// Distance from the bottom of a text row's bounding box to the text baseline.
+// Keeps typed text sitting just above the printed underline.
+const BASELINE_OFFSET = 4.5;
+
+/** Single-line text printed after a label. `rowBottom` is the label row's bottom edge. */
+const textOnLine = (x, rowBottom, maxWidth) => ({
+  kind: 'text',
+  x,
+  y: rowBottom - BASELINE_OFFSET,
+  maxWidth,
+});
+
+/**
+ * A bold label followed by the value, for data the template has no line for
+ * (e.g. the freight bill number). `y` is the text baseline.
+ */
+const labeledText = (label, x, y, maxWidth) => ({ kind: 'labeledText', label, x, y, maxWidth });
+
+/** The freight bill sits in the empty top-right corner, level with the logo, on every form. */
+const freightBillLayout = () => labeledText('Freight Bill #:', 398, 42, 174);
+
+/** An X drawn inside a checkbox whose centre is (x, y). */
+const checkAt = (x, y) => ({ kind: 'check', x, y });
+
+/** One checkbox per choice option, e.g. VVTT "Passed" / "N/A". */
+const checkOptions = (options) => ({ kind: 'checkOptions', options });
+
+/** An ellipse drawn around a printed word, e.g. Cross-Dock "Yes" / "No". */
+const circleOptions = (options) => ({ kind: 'circleOptions', options });
+
+/** A signature (image or typed text) whose bottom-left corner sits on a signature line. */
+const signatureOnLine = (x, rowBottom, width, height = 20) => ({
+  kind: 'signature',
+  x,
+  y: rowBottom - 2,
+  width,
+  height,
+});
+
+/** The ellipse around a word spanning [xStart, xEnd] on a row centred at `y`. */
+const ringAround = (xStart, xEnd, y) => ({
+  cx: (xStart + xEnd) / 2,
+  cy: y,
+  rx: (xEnd - xStart) / 2 + 1,
+  ry: 8,
+});
+
+module.exports = {
+  textOnLine,
+  labeledText,
+  freightBillLayout,
+  checkAt,
+  checkOptions,
+  circleOptions,
+  signatureOnLine,
+  ringAround,
+};
