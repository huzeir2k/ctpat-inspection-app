 # ====================
@@ -30,10 +34,17 @@ CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081
 # Set to true in production with HTTPS
 HTTPS_ENABLED=false
 
+# Number of reverse proxies in front of the server (Render = 1, the default in
+# production). Needed so rate limiting sees real client IPs.
+# TRUST_PROXY_HOPS=1
+
 # ====================
 # EMAIL SERVICE (Optional)
 # ====================
-# Provider: smtp, sendgrid, gmail, ethereal
+# Optional: comma-separated recipient domains the app may email (empty = any)
+# EMAIL_ALLOWED_DOMAINS=yourcompany.com
+
+# Provider: smtp, sendgrid, gmail
 EMAIL_PROVIDER=smtp
 
 # SMTP Configuration (for smtp provider)
@@ -69,6 +80,9 @@ RATE_LIMIT_AUTH=20
 # ====================
 # JWT/AUTH
 # ====================
-JWT_SECRET=lolno
-# JWT_EXPIRY=7d
+# Supabase Auth's JWT signing secret (legacy HS256 shared secret), used to verify
+# access tokens on every authenticated request. Get from Supabase Dashboard >
+# Settings > API > JWT Settings. Required — the server refuses all auth'd
+# requests if this is unset.
+SUPABASE_JWT_SECRET=your-supabase-jwt-secret
 
