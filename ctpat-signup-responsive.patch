+import React from 'react';
+import { ActivityIndicator, StyleSheet, TouchableOpacity } from 'react-native';
+import Text from './AppText';
+
+interface Props {
+  title: string;
+  onPress: () => void;
+  isLoading?: boolean;
+  disabled?: boolean;
+  /** "primary" is the filled main action; "link" is a quiet text button. */
+  variant?: 'primary' | 'link';
+}
+
+export default function AuthButton({ title, onPress, isLoading = false, disabled = false, variant = 'primary' }: Props) {
+  const isPrimary = variant === 'primary';
+  const isDisabled = disabled || isLoading;
+
+  return (
+    <TouchableOpacity
+      style={[isPrimary ? styles.primary : styles.link, isDisabled && styles.disabled]}
+      onPress={onPress}
+      disabled={isDisabled}
+      accessibilityRole="button"
+    >
+      {isLoading ? (
+        <ActivityIndicator color={isPrimary ? '#fff' : '#0066cc'} />
+      ) : (
+        <Text style={isPrimary ? styles.primaryText : styles.linkText}>{title}</Text>
+      )}
+    </TouchableOpacity>
+  );
+}
+
+const styles = StyleSheet.create({
+  primary: {
+    backgroundColor: '#0066cc',
+    borderRadius: 8,
+    minHeight: 48,
+    paddingVertical: 14,
+    alignItems: 'center',
+    justifyContent: 'center',
+    marginTop: 24,
+  },
+  primaryText: { color: '#fff', fontSize: 16, fontWeight: '600' },
+  link: { minHeight: 44, alignItems: 'center', justifyContent: 'center', marginTop: 8 },
+  linkText: { color: '#0066cc', fontSize: 15, fontWeight: '600' },
+  disabled: { opacity: 0.6 },
+});
