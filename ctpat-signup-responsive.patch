diff --git a/ctpat-inspection/app/components/useAuthSubmit.ts b/ctpat-inspection/app/components/useAuthSubmit.ts
new file mode 100644
index 0000000..f045a95
--- /dev/null
+++ b/ctpat-inspection/app/components/useAuthSubmit.ts
@@ -0,0 +1,34 @@
+import { useCallback, useState } from 'react';
+import { describeAuthError } from '../models/authErrors';
+import type { AuthNotice } from './AuthScreen';
+
+/**
+ * Shared "submit" behaviour of the signed-out screens: one request at a time, a spinner
+ * while it runs, and any failure turned into a message for the notice area.
+ */
+export default function useAuthSubmit() {
+  const [notice, setNotice] = useState<AuthNotice | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  const showError = useCallback((text: string) => setNotice({ kind: 'error', text }), []);
+  const showInfo = useCallback((text: string) => setNotice({ kind: 'info', text }), []);
+  const clearNotice = useCallback(() => setNotice(null), []);
+
+  const submit = useCallback(
+    async (action: () => Promise<void>) => {
+      if (isSubmitting) return;
+      setNotice(null);
+      setIsSubmitting(true);
+      try {
+        await action();
+      } catch (error) {
+        showError(describeAuthError(error).message);
+      } finally {
+        setIsSubmitting(false);
+      }
+    },
+    [isSubmitting, showError]
+  );
+
+  return { notice, isSubmitting, submit, showError, showInfo, clearNotice };
+}
diff --git a/ctpat-inspection/app/components/useCooldown.ts b/ctpat-inspection/app/components/useCooldown.ts
new file mode 100644
index 0000000..dbce9b3
--- /dev/null
+++ b/ctpat-inspection/app/components/useCooldown.ts
@@ -0,0 +1,19 @@
+import { useCallback, useEffect, useState } from 'react';
+
+/**
+ * A countdown for "Resend code" buttons, so a user cannot hammer the email service.
+ * `secondsLeft` is 0 when the action is allowed; `start` begins a new wait.
+ */
+export default function useCooldown(seconds: number) {
+  const [secondsLeft, setSecondsLeft] = useState(0);
+
+  useEffect(() => {
+    if (secondsLeft <= 0) return;
+    const timer = setTimeout(() => setSecondsLeft((left) => left - 1), 1000);
+    return () => clearTimeout(timer);
+  }, [secondsLeft]);
+
+  const start = useCallback(() => setSecondsLeft(seconds), [seconds]);
+
+  return { secondsLeft, start };
+}
diff --git a/ctpat-inspection/app/components/useScreenSize.ts b/ctpat-inspection/app/components/useScreenSize.ts
new file mode 100644
index 0000000..cb9e4b1
--- /dev/null
+++ b/ctpat-inspection/app/components/useScreenSize.ts
@@ -0,0 +1,12 @@
+import { useWindowDimensions } from 'react-native';
+import { EXPANDED_MIN_WIDTH } from '../models/theme';
+
+/**
+ * The size of the window the app is drawn in, and whether it is wide enough for the
+ * expanded layout. It follows the window, not the device: unfolding a foldable, split
+ * screen and rotation all change it, and the screens re-lay themselves out.
+ */
+export default function useScreenSize() {
+  const { width, height } = useWindowDimensions();
+  return { width, height, isExpanded: width >= EXPANDED_MIN_WIDTH };
+}
