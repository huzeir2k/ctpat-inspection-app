# Embedded CTPAT Backend Configuration
# This backend runs directly on the device

NODE_ENV=development
PORT=3000

# Required: verifies Supabase Auth access tokens locally (no network call), so the
# embedded backend keeps working fully offline. Same value as the cloud backend's
# SUPABASE_JWT_SECRET (Supabase Dashboard > Settings > API > JWT Settings).
# SECURITY NOTE: this ships inside the built mobile app bundle. Anyone who extracts
# it from the app package could forge Supabase-signed tokens against your project.
# Treat it like any other embedded API credential and rotate it if you suspect exposure.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional: Supabase configuration (for cloud backup)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET=

# Optional: Email configuration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_RECIPIENT=
