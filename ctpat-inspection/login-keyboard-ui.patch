+/**
+ * Stand-in for Supabase Auth's password sign-in, so the login screen can be tested.
+ * Right email and password: a session. Anything else: the same 400 Supabase sends.
+ */
+const createFakeAuthHandler = (accessToken) => (req, res) => {
+  const cors = {
+    'Access-Control-Allow-Origin': '*',
+    'Access-Control-Allow-Headers': 'apikey, authorization, content-type, x-client-info, x-supabase-api-version',
+    'Access-Control-Allow-Methods': 'POST, OPTIONS',
+  };
+  if (req.method === 'OPTIONS') return res.writeHead(204, cors).end();
+
+  const url = new URL(req.url, 'http://x');
+  if (req.method !== 'POST' || url.pathname !== '/auth/v1/token' || url.searchParams.get('grant_type') !== 'password') {
+    return res.writeHead(404, cors).end();
+  }
+
+  let body = '';
+  req.on('data', (chunk) => (body += chunk));
+  req.on('end', () => {
+    let credentials = {};
+    try {
+      credentials = JSON.parse(body);
+    } catch {
+      /* treated as wrong credentials below */
+    }
+    const json = { ...cors, 'Content-Type': 'application/json' };
+    if (credentials.email === TEST_LOGIN.email && credentials.password === TEST_LOGIN.password) {
+      const now = Math.floor(Date.now() / 1000);
+      return res.writeHead(200, json).end(
+        JSON.stringify({
+          access_token: accessToken,
+          token_type: 'bearer',
+          expires_in: 3600,
+          expires_at: now + 3600,
+          refresh_token: 'e2e-refresh',
+          user: { id: USER_ID, email: TEST_LOGIN.email, aud: 'authenticated', role: 'authenticated', app_metadata: {}, user_metadata: {}, created_at: new Date().toISOString() },
+        })
+      );
+    }
+    res.writeHead(400, json).end(JSON.stringify({ code: 400, error_code: 'invalid_credentials', msg: 'Invalid login credentials' }));
+  });
+};
